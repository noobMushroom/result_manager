{
  "db_name": "PostgreSQL",
  "query": "\n        SELECT\n            s.id,\n            s.name,\n            s.father_name,\n            g.name          AS grade_name,\n            s.admission_no,\n            s.date_of_birth\n        FROM students s\n        JOIN grades g\n            ON s.grade_id = g.id\n        WHERE s.grade_id = $1\n        ORDER BY s.admission_no\n        ",
